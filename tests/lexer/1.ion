import("std.string");

proc main() i32 {
    my_i32_variable: i32 = 100;
    my_f32_variable: f32 = 100.0;
    my_string_variable := string:from("Hello World");
    println(my_string_variable);

    {
        {
            println("Hellow");
            println("Hellow");
        }
    }

    return 0;
}
