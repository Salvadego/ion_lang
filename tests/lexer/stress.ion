proc main() {
    import math;

    struct Vec2 {
        x: f32;
        y: f32;
    }

    enum Color {
        Red,
        Green,
        Blue,
    }

    if (x < 10) {
        return x + 1;
    } else {
        return x - 1;
    }
}

