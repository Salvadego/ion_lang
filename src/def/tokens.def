SINGLE_TOKEN_DEF(TOKENTYPE_INVALID, 0, INVALID)
SINGLE_TOKEN_DEF(TOKENTYPE_LPAREN, '(', LPAREN)
SINGLE_TOKEN_DEF(TOKENTYPE_RPAREN, ')', RPAREN)
SINGLE_TOKEN_DEF(TOKENTYPE_LBRACE, '{', LBRACE)
SINGLE_TOKEN_DEF(TOKENTYPE_RBRACE, '}', RBRACE)
SINGLE_TOKEN_DEF(TOKENTYPE_LBRACKET, '[', LBRACKET)
SINGLE_TOKEN_DEF(TOKENTYPE_RBRACKET, ']', RBRACKET)
SINGLE_TOKEN_DEF(TOKENTYPE_SEMICOLON, ';', SEMICOLON)
SINGLE_TOKEN_DEF(TOKENTYPE_COLON, ':', COLON)
SINGLE_TOKEN_DEF(TOKENTYPE_COMMA, ',', COMMA)
SINGLE_TOKEN_DEF(TOKENTYPE_PLUS, '+', PLUS)
SINGLE_TOKEN_DEF(TOKENTYPE_MINUS, '-', MINUS)
SINGLE_TOKEN_DEF(TOKENTYPE_UNDERSCORE, '_', UNDERSCORE)
SINGLE_TOKEN_DEF(TOKENTYPE_STAR, '*', STAR)
SINGLE_TOKEN_DEF(TOKENTYPE_SLASH, '/', SLASH)
SINGLE_TOKEN_DEF(TOKENTYPE_EQUAL, '=', EQUAL)
SINGLE_TOKEN_DEF(TOKENTYPE_LESSTHAN, '<', LESS)
SINGLE_TOKEN_DEF(TOKENTYPE_GREATERTHAN, '>', GREATER)
SINGLE_TOKEN_DEF(TOKENTYPE_DOT, '.', DOT)
SINGLE_TOKEN_DEF(TOKENTYPE_AND, '&', AND)
SINGLE_TOKEN_DEF(TOKENTYPE_OR, '|', OR)
SINGLE_TOKEN_DEF(TOKENTYPE_NOT, '!', BANG)
SINGLE_TOKEN_DEF(TOKENTYPE_XOR, '^', XOR)
SINGLE_TOKEN_DEF(TOKENTYPE_MOD, '%', PERCENT)

MULTI_LITERAL_DEF(TOKENTYPE_PROCEDURE, "proc", PROCEDURE)
MULTI_LITERAL_DEF(TOKENTYPE_RETURN, "return", RETURN)
MULTI_LITERAL_DEF(TOKENTYPE_IMPORT, "import", IMPORT)
MULTI_LITERAL_DEF(TOKENTYPE_STRUCT, "struct", STRUCT)
MULTI_LITERAL_DEF(TOKENTYPE_ENUM, "enum", ENUM)

COMPLEX_TOKEN_DEF(TOKENTYPE_STRING, STRING)
COMPLEX_TOKEN_DEF(TOKENTYPE_CHAR, CHAR)
COMPLEX_TOKEN_DEF(TOKENTYPE_NUMBER, NUMBER)
COMPLEX_TOKEN_DEF(TOKENTYPE_IDENTIFIER, IDENTIFIER)

COMPLEX_TOKEN_DEF(TOKENTYPE_EOF, EOF)
