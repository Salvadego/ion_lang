TOKEN_DEF(TOKENTYPE_EOF, "EOF", EOF)
TOKEN_DEF(TOKENTYPE_LPAREN, "(", LPAREN)
TOKEN_DEF(TOKENTYPE_RPAREN, ")", RPAREN)
TOKEN_DEF(TOKENTYPE_LBRACE, "{", LBRACE)
TOKEN_DEF(TOKENTYPE_RBRACE, "}", RBRACE)
TOKEN_DEF(TOKENTYPE_SEMICOLON, ";", SEMICOLON)
TOKEN_DEF(TOKENTYPE_COLON, ":", COLON)
TOKEN_DEF(TOKENTYPE_COMMA, ",", COMMA)
TOKEN_DEF(TOKENTYPE_PLUS, "+", PLUS)
TOKEN_DEF(TOKENTYPE_MINUS, "-", MINUS)
TOKEN_DEF(TOKENTYPE_UNDERSCORE, "_", UNDERSCORE)
TOKEN_DEF(TOKENTYPE_STAR, "*", STAR)
TOKEN_DEF(TOKENTYPE_SLASH, "/", SLASH)
TOKEN_DEF(TOKENTYPE_EQUAL, "=", EQUAL)
TOKEN_DEF(TOKENTYPE_LESSTHAN, "<", LESSTHAN)
TOKEN_DEF(TOKENTYPE_GREATERTHAN, ">", GREATERTHAN)
TOKEN_DEF(TOKENTYPE_PERIOD, ".", PERIOD)
TOKEN_DEF(TOKENTYPE_AND, "&", AND)
TOKEN_DEF(TOKENTYPE_OR, "|", OR)
TOKEN_DEF(TOKENTYPE_NOT, "!", NOT)
TOKEN_DEF(TOKENTYPE_XOR, "^", XOR)
TOKEN_DEF(TOKENTYPE_MOD, "%", MOD)
TOKEN_DEF(TOKENTYPE_PROCEDURE, "proc", PROCEDURE)
TOKEN_DEF(TOKENTYPE_RETURN, "return", RETURN)
TOKEN_DEF(TOKENTYPE_TYPE, "", TYPE)
TOKEN_DEF(TOKENTYPE_STRING, "", STRING)
TOKEN_DEF(TOKENTYPE_NUMBER, "", NUMBER)
TOKEN_DEF(TOKENTYPE_IDENTIFIER, "", IDENTIFIER)
