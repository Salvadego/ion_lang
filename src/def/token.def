TOKEN_DEF(TOKENTYPE_RPAREN, ")")
TOKEN_DEF(TOKENTYPE_LBRACE, "{")
TOKEN_DEF(TOKENTYPE_RBRACE, "}")
TOKEN_DEF(TOKENTYPE_SEMICOLON, ";")
TOKEN_DEF(TOKENTYPE_COMMA, ",")
TOKEN_DEF(TOKENTYPE_PLUS, "+")
TOKEN_DEF(TOKENTYPE_SYMBOL, "SYMBOL")
